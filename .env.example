# ==========================================
# AGRIBRIDGE ENVIRONMENT CONFIGURATION
# ==========================================

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:5000/api

# Backend Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_at_least_32_characters

# Database Configuration (PostgreSQL / Supabase / Neon / Local)
DB_TYPE=postgres
# Option 1: Connection string (Recommended for PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/agribridge
# Option 2: Individual parameters
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=agribridge
DB_SSL=false

# Cloudinary Storage (Backend only; never expose as VITE_ variables)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
MAX_FILE_SIZE_BYTES=10485760
ALLOWED_UPLOAD_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,application/pdf

# Email / SMTP Configuration (Nodemailer for OTP & Password Reset)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_16_character_google_app_password
EMAIL_FROM=AgriBridge <no-reply@agribridge.com>

# Local fallback uploads directory (optional)
LOCAL_UPLOADS_DIR=./uploads

